APP_NAME="LeadFlow Pro API"
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=LeadFlow Pro <notifications@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com
DEEPSEEK_API_KEY=sk-xxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
FOLLOWUP_JOB_SECRET=replace-with-random-secret
